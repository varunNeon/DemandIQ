# DemandIQ Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
# Default: SQLite (no setup required). Change to PostgreSQL URL to use Postgres.
# SQLite example:   sqlite:///./demandiq.db
# PostgreSQL example: postgresql://user:password@localhost:5432/demandiq
DATABASE_URL=sqlite:///./demandiq.db

# --- Application ---
# Set to "demo" to use synthetic demo data, "real" to use downloaded Kaggle data
DATA_MODE=demo

# --- Logging ---
LOG_LEVEL=INFO

# --- Forecasting ---
# Comma-separated list of models to train: naive,seasonal_naive,ets,lgbm
ENABLED_MODELS=naive,seasonal_naive,ets,lgbm
DEFAULT_HORIZON=14
BACKTEST_SPLITS=3

# --- Random Seeds (for reproducibility) ---
RANDOM_SEED=42
